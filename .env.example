# ============================================================
#  BobiChat — Environment Variables Template
#  Скопіюйте цей файл у .env та вставте свої значення.
#  Команда: cp .env.example .env
# ============================================================

# --- Firebase Web SDK Config ---
# Де взяти: https://console.firebase.google.com/
#   → Ваш проєкт → Налаштування проєкту (⚙️) → Загальні → Ваші застосунки → SDK setup → Config
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id_suffix
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Google Sign-In (OAuth 2.0) ---
# Де взяти: https://console.firebase.google.com/
#   → Authentication → Sign-in method → Google → Web client ID
# АБО: https://console.cloud.google.com/ → APIs & Services → Credentials → OAuth 2.0 Client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
